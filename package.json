{
  "name": "sgo-oficina",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src functions/*.js scripts/*.mjs tests App.tsx",
    "test": "tsx --test tests/domain.test.ts",
    "test:rules": "firebase emulators:exec --project demo-sgo --only firestore,storage \"tsx --test tests/rules.test.ts\"",
    "test:e2e": "playwright test",
    "emulators": "node scripts/start-emulators.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test:admin": "tsx --test tests/admin-login.test.ts",
    "test:backend": "firebase emulators:exec --project demo-sgo --only auth,firestore,functions \"tsx --test tests/backend.test.ts tests/migration.test.ts\"",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~57.0.24",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.2",
    "eslint": "^10.11.0",
    "firebase-tools": "^15.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
