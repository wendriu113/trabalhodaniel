# Configuração PÚBLICA do aplicativo web cadastrado no Firebase (não usar chave Admin).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Para testar sem projeto real: true. Dados locais em demo-sgo.
EXPO_PUBLIC_USE_EMULATORS=false
# No celular físico use o IP do computador na mesma rede; no Android emulado: 10.0.2.2.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
